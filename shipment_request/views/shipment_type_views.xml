<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_shipment_type_list" model="ir.ui.view">
        <field name="name">shipment.type.list</field>
        <field name="model">shipment.type</field>
        <field name="arch" type="xml">
            <list string="Shipment Types" decoration-muted="not active">
                <field name="name"/>
                <field name="code"/>
                <field name="category"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_shipment_type_form" model="ir.ui.view">
        <field name="name">shipment.type.form</field>
        <field name="model">shipment.type</field>
        <field name="arch" type="xml">
            <form string="Shipment Type">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <field name="active" invisible="1"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Road Express"/></h1>
                    </div>
                    <group>
                        <field name="code" placeholder="e.g. ROAD"/>
                        <field name="category"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_shipment_type_search" model="ir.ui.view">
        <field name="name">shipment.type.search</field>
        <field name="model">shipment.type</field>
        <field name="arch" type="xml">
            <search string="Search Shipment Types">
                <field name="name"/>
                <field name="code"/>
                <field name="category"/>
                <separator/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_category" string="Category" context="{'group_by': 'category'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_shipment_type" model="ir.actions.act_window">
        <field name="name">Shipment Types</field>
        <field name="res_model">shipment.type</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_shipment_type_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a shipment type</p>
            <p>Give each type a clear name, a unique code, and a category. Archive types you no longer use.</p>
        </field>
    </record>
</odoo>
