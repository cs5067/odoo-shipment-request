<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_shipments" model="ir.module.category">
        <field name="name">Shipments</field>
        <field name="sequence">30</field>
    </record>
    <record id="privilege_shipments" model="res.groups.privilege">
        <field name="name">Shipments</field>
        <field name="category_id" ref="module_category_shipments"/>
        <field name="sequence">10</field>
    </record>
    <record id="group_shipment_user" model="res.groups">
        <field name="name">Shipment User</field>
        <field name="privilege_id" ref="privilege_shipments"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_shipment_manager" model="res.groups">
        <field name="name">Shipment Manager</field>
        <field name="privilege_id" ref="privilege_shipments"/>
        <field name="implied_ids" eval="[(4, ref('group_shipment_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
    </record>
</odoo>
